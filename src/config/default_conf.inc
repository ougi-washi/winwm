"# Desktop configuration. Changes take effect with Super+Shift+R.\n"
"$mainMod = SUPER\n"
"$terminal = auto\n"
"$menu = Run\n"
"\n"
"general {\n"
"    gaps_in = 6\n"
"    gaps_out = 6\n"
"    col.active_border = rgb(91aaf7)\n"
"    col.inactive_border = rgb(292b33)\n"
"}\n"
"decoration {\n"
"    inactive_opacity = 0.98\n"
"}\n"
"input {\n"
"    follow_mouse = 1\n"
"}\n"
"bar {\n"
"    position = top\n"
"    height = 32\n"
"    modules_left = menu workspaces mode\n"
"    modules_center = clock\n"
"    modules_right = bluetooth network audio keyboard battery\n"
"    background = rgb(101116)\n"
"    foreground = rgb(e4e5ea)\n"
"}\n"
"programs {\n"
"    terminal = $terminal\n"
"    file_browser = FilePilot.exe\n"
"    task_manager = TaskSlinger.exe\n"
"    editor = %SystemRoot%\\System32\\notepad.exe\n"
"}\n"
"\n"
"# Start applications and manage windows.\n"
"bind = $mainMod, Return, exec, $terminal\n"
"bind = $mainMod SHIFT, q, killactive\n"
"bind = $mainMod, d, exec, $menu\n"
"bind = $mainMod, b, exec, brave\n"
"bind = $mainMod, l, movefocus, r\n"
"bind = $mainMod SHIFT, t, winwm, open_tasks\n"
"bind = $mainMod SHIFT, r, winwm, reload\n"
"bind = $mainMod SHIFT, e, winwm, confirm_sign_out\n"
"bind = $mainMod, space, winwm, focus_mode_toggle\n"
"bind = $mainMod, e, togglesplit\n"
"bind = , print, winwm, capture_region\n"
"bind = $mainMod, f6, winwm, capture_region\n"
"bind = , XF86AudioMute, winwm, mute\n"
"binde = , XF86AudioRaiseVolume, winwm, volume_up\n"
"binde = , XF86AudioLowerVolume, winwm, volume_down\n"
"bind = $mainMod, h, winwm, split horizontal\n"
"bind = $mainMod, v, winwm, split vertical\n"
"bind = $mainMod, s, winwm, layout stack\n"
"bind = $mainMod, w, winwm, layout tabs\n"
"bind = $mainMod, f, fullscreen, 0\n"
"bind = $mainMod SHIFT, space, togglefloating\n"
"bind = $mainMod, minus, winwm, scratch_show\n"
"bind = $mainMod SHIFT, minus, winwm, scratch_send\n"
"bind = $mainMod, r, submap, resize\n"
"bind = $mainMod, left, movefocus, l\n"
"bind = $mainMod SHIFT, left, movewindow, l\n"
"bind = $mainMod SHIFT, h, movewindow, l\n"
"bind = $mainMod, down, movefocus, d\n"
"bind = $mainMod SHIFT, down, movewindow, d\n"
"bind = $mainMod SHIFT, j, movewindow, d\n"
"bind = $mainMod, up, movefocus, u\n"
"bind = $mainMod SHIFT, up, movewindow, u\n"
"bind = $mainMod SHIFT, k, movewindow, u\n"
"bind = $mainMod, right, movefocus, r\n"
"bind = $mainMod SHIFT, right, movewindow, r\n"
"bind = $mainMod SHIFT, l, movewindow, r\n"
"bind = $mainMod, 1, workspace, 1\n"
"bind = $mainMod SHIFT, 1, movetoworkspacesilent, 1\n"
"bind = $mainMod, 2, workspace, 2\n"
"bind = $mainMod SHIFT, 2, movetoworkspacesilent, 2\n"
"bind = $mainMod, 3, workspace, 3\n"
"bind = $mainMod SHIFT, 3, movetoworkspacesilent, 3\n"
"bind = $mainMod, 4, workspace, 4\n"
"bind = $mainMod SHIFT, 4, movetoworkspacesilent, 4\n"
"bind = $mainMod, 5, workspace, 5\n"
"bind = $mainMod SHIFT, 5, movetoworkspacesilent, 5\n"
"bind = $mainMod, 6, workspace, 6\n"
"bind = $mainMod SHIFT, 6, movetoworkspacesilent, 6\n"
"bind = $mainMod, 7, workspace, 7\n"
"bind = $mainMod SHIFT, 7, movetoworkspacesilent, 7\n"
"bind = $mainMod, 8, workspace, 8\n"
"bind = $mainMod SHIFT, 8, movetoworkspacesilent, 8\n"
"bind = $mainMod, 9, workspace, 9\n"
"bind = $mainMod SHIFT, 9, movetoworkspacesilent, 9\n"
"bind = $mainMod, 0, workspace, 10\n"
"bind = $mainMod SHIFT, 0, movetoworkspacesilent, 10\n"
"\n"
"# Adjust width or height in physical pixels. Release Super after entering the submap.\n"
"submap = resize\n"
"binde = , left, resizeactive, -100 0\n"
"binde = , h, resizeactive, -100 0\n"
"binde = , right, resizeactive, 100 0\n"
"binde = , l, resizeactive, 100 0\n"
"binde = , up, resizeactive, 0 -100\n"
"binde = , k, resizeactive, 0 -100\n"
"binde = , down, resizeactive, 0 100\n"
"binde = , j, resizeactive, 0 100\n"
"bind = , Return, submap, reset\n"
"bind = , Escape, submap, reset\n"
"submap = reset\n"
