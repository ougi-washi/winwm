{
  "version": 1,
  "file_browser": "FilePilot.exe",
  "task_manager": "TaskSlinger.exe",
  "terminal": "auto",
  "editor": "%SystemRoot%\\System32\\notepad.exe",
  "gap": 6,
  "edge": "top",
  "bar_height": 32,
  "bar_left": "menu workspaces mode",
  "bar_center": "clock",
  "bar_right": "bluetooth network audio battery",
  "background": "#101116",
  "foreground": "#e4e5ea",
  "accent": "#91aaf7",
  "bindings": {
    "super+enter": "terminal",
    "super+shift+q": "close",
    "super+d": "launcher",
    "super+b": "launch brave",
    "super+l": "focus right",
    "super+shift+t": "open_tasks",
    "super+shift+r": "reload",
    "super+shift+e": "confirm_sign_out",
    "super+space": "focus_mode_toggle",
    "super+e": "layout toggle_split",
    "resize:enter": "resize_mode",
    "print": "capture_region",
    "super+f6": "capture_region",
    "volume_mute": "mute",
    "repeat:volume_up": "volume_up",
    "repeat:volume_down": "volume_down",
    "resize:repeat:left": "resize left",
    "resize:repeat:down": "resize down",
    "resize:repeat:up": "resize up",
    "resize:repeat:right": "resize right",
    "resize:repeat:h": "resize left",
    "resize:repeat:j": "resize down",
    "resize:repeat:k": "resize up",
    "resize:repeat:l": "resize right",
    "super+h": "split horizontal",
    "super+v": "split vertical",
    "super+s": "layout stack",
    "super+w": "layout tabs",
    "super+f": "fullscreen",
    "super+shift+space": "floating",
    "super+minus": "scratch_show",
    "super+shift+minus": "scratch_send",
    "super+r": "resize_mode",
    "resize:escape": "resize_mode",
    "super+left": "focus left",
    "super+shift+left": "move left",
    "super+shift+h": "move left",
    "super+down": "focus down",
    "super+shift+down": "move down",
    "super+shift+j": "move down",
    "super+up": "focus up",
    "super+shift+up": "move up",
    "super+shift+k": "move up",
    "super+right": "focus right",
    "super+shift+right": "move right",
    "super+shift+l": "move right",
    "super+1": "workspace_select 1",
    "super+shift+1": "workspace_send 1",
    "super+2": "workspace_select 2",
    "super+shift+2": "workspace_send 2",
    "super+3": "workspace_select 3",
    "super+shift+3": "workspace_send 3",
    "super+4": "workspace_select 4",
    "super+shift+4": "workspace_send 4",
    "super+5": "workspace_select 5",
    "super+shift+5": "workspace_send 5",
    "super+6": "workspace_select 6",
    "super+shift+6": "workspace_send 6",
    "super+7": "workspace_select 7",
    "super+shift+7": "workspace_send 7",
    "super+8": "workspace_select 8",
    "super+shift+8": "workspace_send 8",
    "super+9": "workspace_select 9",
    "super+shift+9": "workspace_send 9",
    "super+0": "workspace_select 10",
    "super+shift+0": "workspace_send 10"
  },
  "apps": {
    "Notepad": "%SystemRoot%\\System32\\notepad.exe"
  }
}
